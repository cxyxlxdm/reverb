// ⚠️ 这是**模板**。真正被 hvigor 读取的是同目录的 build-profile.json5,
// 它已从版本管理移出(见 .gitignore),因为里面会存签名口令。
//
// 新机器/重新 clone 后:
//   1. cp build-profile.template.json5 build-profile.json5
//   2. DevEco → File → Project Structure → Signing Configs,
//      给 release 那条填 Key alias / Key password / Store password
//      (三项在本模板里是空串;debug 那条 DevEco 会自动生成)
//   3. 把 reverb.p12 / reverb.cer / reverb.p7b 放进 ./signature/(该目录也不入库)
//
// 若你改了 products / targets / SDK 版本这类**非机密**配置,记得同步回本模板,
// 否则下次从模板重建会丢配置。
{
  "app": {
    "products": [
      {
        // 日常开发/真机调试用。签名是 DevEco 自动生成的调试证书,不能发布。
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.0.2(22)",
        "targetSdkVersion": "6.0.2(22)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true
          }
        }
      },
      {
        // 发布用。**单独一个 product,不是改 default** ——
        // 发布证书/Profile 未就位时,若把 default 的签名换成 release,
        // 日常 `hdc install` 会立刻全部失败。分开后两条路互不影响:
        //   调试:hvigorw assembleHap --mode module -p product=default -p buildMode=debug
        //   发布:hvigorw assembleApp  --mode project -p product=release -p buildMode=release
        "name": "release",
        "signingConfig": "release",
        "compatibleSdkVersion": "6.0.2(22)",
        "targetSdkVersion": "6.0.2(22)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "<你的 .ohos 配置目录>/<调试证书>.cer",
          "keyAlias": "debugKey",
          "keyPassword": "",
          "profile": "<你的 .ohos 配置目录>/<调试证书>.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "<你的 .ohos 配置目录>/<调试证书>.p12",
          "storePassword": ""
        }
      },
      {
        "name": "release",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "./signature/reverb.p12",
          "storePassword": "",
          "keyAlias": "",
          "keyPassword": "",
          "signAlg": "SHA256withECDSA",
          "profile": "./signature/reverb.p7b",
          "certpath": "./signature/reverb.cer"
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          // entry 模块同时供两个 product 使用,漏了 "release" 会导致 release 产品打不出 hap
          "name": "default",
          "applyToProducts": [
            "default",
            "release"
          ]
        }
      ]
    }
  ]
}
