<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="reverb_ink_bg">#0E1416</color>
    <color name="ic_launcher_bg">#10262B</color>

    <!-- 小组件配色(浅色默认;深色在 values-night/colors.xml)。取自主界面的纸面/墨色,
         但强调色压深了一档:小组件背景比 App 内更亮,原色 Celadon 当文字会发虚。 -->
    <color name="widget_bg">#FCFAF4</color>
    <color name="widget_border">#E4DDCE</color>
    <color name="widget_text">#1B2426</color>
    <color name="widget_text_secondary">#66716F</color>
    <color name="widget_accent">#3F8A7C</color>
    <color name="widget_track">#E7E0D1</color>
    <!-- 压在 accent 圆底上的图标色。与鸿蒙 WidgetCard.onAccent() 同一口径:
         浅色档 accent 够深,用白色;深色档 accent 是浅青,白图标会糊在一起,改用深墨色。 -->
    <color name="widget_on_accent">#FFFFFF</color>
</resources>
