    <!-- 关于 -->
    <string name="about_app">余音 · Reverb</string>
    <string name="about_version">版本 1.0.0</string>
    <string name="about_h_what">这是什么</string>
    <string name="about_p_what">余音是一款轻量的播客客户端。发现好节目、订阅收听、离线下载、随时续播，专注「听」本身。</string>
    <string name="about_h_features">主要功能</string>
    <string name="about_p_features">· 发现：按地区与分类浏览每日热门，可自定义分类排序、横滑切换\n· 搜索：按名字或直接粘贴 RSS 地址\n· 订阅与「音阁」：订阅、下载、历史三栏管理\n· 离线下载：边听边缓存，可仅 Wi-Fi 下载\n· 逐字稿：本机离线转写，或直接读发布方提供的稿\n· 播放：倍速、快进快退、睡眠定时、自动续播、后台与锁屏控制\n· 节目笔记：播放页横滑查看\n· 订阅更新提醒：有新一期时通知\n· 外观：深色/浅色/跟随系统、字号、主题配色、多语言</string>
    <string name="about_h_philosophy">设计理念</string>
    <string name="about_p_philosophy">美学上取「水墨 + 青瓷 + 梁金」的底色，名字与图标呼应「余音绕梁」——声波环绕横梁，余韵不散。\n\n取源上坚持全链路免费、无需登录、无需任何 API Key：检索一律基于公开来源，最终始终回到发布方自己的 RSS，直接流式播放原始音频——版权干净、成本为零。\n\n隐私上，订阅、历史、下载全部只存在你的设备本地，不上传、不追踪。</string>

    <!-- 开源许可 -->
    <string name="licenses_title">开源许可</string>
    <string name="licenses_intro">余音使用了以下开源软件，谨致谢意。</string>
    <string name="licenses_h_libs">开源库</string>
