<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 竖高变体(这台桌面实测 130×206dp):海报铺上半张、文字压在下面。
     与 widget_small 的区别只在排法 —— 同一个 2×2 在别的桌面上可能是正方形或宽扁的,
     那时 widget_small 的「左封面 + 右文字」更合适,所以由 Provider 按宽高比挑,不靠本文件自适应。
     层级只用 LinearLayout / FrameLayout(见 widget_medium 头注):RemoteViews 不允许 android.widget.Space。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 海报吃掉剩余高度:竖高的格子里它是主角,固定尺寸会在上下各留一大块空白。 -->
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="9sp"
        tools:text="继续收听" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="为什么我们总在深夜想起小时候的夏天" />

    <TextView
        android:id="@+id/widget_podcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp"
        tools:text="声动早咖啡" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="@color/widget_track"
        android:progressTint="@color/widget_accent" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp"
        tools:text="12:34 / 52:10" />
</LinearLayout>
