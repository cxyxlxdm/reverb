<?xml version="1.0" encoding="utf-8"?>
<!-- H84:系统级备份白名单(Android 11 及以下读本文件,12+ 读 data_extraction_rules.xml)。
     一旦声明 include,未列出的一律不进备份——音频 downloads/、逐字稿 transcripts/、
     feed/popular/inbox 缓存、logs/、default 渠道的 57MB whisper 模型全靠这一点排除,
     否则会撑爆单应用 25MB 云备份配额。口径与手动备份(BackupManager)一致:
     只备可重建用户状态;恢复是文件级覆盖,不是手动备份那种分项合并。 -->
<full-backup-content>
    <include domain="file" path="subscriptions.json" />
    <include domain="file" path="favorites.json" />
    <include domain="file" path="history.json" />
    <include domain="file" path="downloads.json" />
    <include domain="file" path="stamps.json" />
    <!-- 批注必须进白名单:它是**用户写出来的字**,丢了没有任何东西能补回来
         (与 stamps.json 同一判断)。体积代价约 1 KB/条(整集快照),
         相对 25 MB 配额可以忽略;真正占体积的音频/逐字稿仍靠上面那条排除。 -->
    <include domain="file" path="notes.json" />
    <include domain="file" path="listen_stats.json" />
    <include domain="sharedpref" path="reverb_settings.xml" />
    <include domain="sharedpref" path="reverb_prefs.xml" />
    <include domain="sharedpref" path="reverb_updates.xml" />
</full-backup-content>
