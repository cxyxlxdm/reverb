<?xml version="1.0" encoding="utf-8"?>
<!--
  无外框版前景(配 @drawable/ic_launcher_background_none 透明底):图案直接落在壁纸上。

  与深色底版的两处区别:
  1) **放大**:没了深色圆角矩形做视觉容器,图案要占更多面积才立得住 ——
     宽度 48dp → **58dp**(占可见区 72dp 的 80%,深色底版是 67%);
     外弧半径 29dp,左右各留 7dp 余量(x 25..83,仍在可见区 18..90 内)。
  2) **声波弧改为不透明的深浅梯度**(内亮 → 外深)。深色底版的弧是半透明(0.46/0.72),
     那是为压在水墨底上设计的;去掉底后半透明弧在浅色壁纸上会发虚,必须换实色。

  几何比例仍守两条规则(与 macOS 版一致):横梁 = 外弧直径的 80% 且居中略短于半圆;
  图案在 108 画布内竖向居中。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 梁 · 横梁主体(46.6dp ≈ 外弧直径 58dp 的 80%) -->
    <path
        android:fillColor="#E9C879"
        android:pathData="M32.9,36.9 h42.2 a2.2,2.2 0 0 1 2.2,2.2 v5.8 a2.2,2.2 0 0 1 -2.2,2.2 h-42.2 a2.2,2.2 0 0 1 -2.2,-2.2 v-5.8 a2.2,2.2 0 0 1 2.2,-2.2 z" />
    <!-- 斗拱两端支点 -->
    <path
        android:fillColor="#C9A252"
        android:pathData="M34.9,47.1 h5.9 v6.4 h-5.9 z M67.7,47.1 h5.9 v6.4 h-5.9 z" />

    <!-- 余音 · 三道声波(不透明梯度:内亮 → 外深) -->
    <path
        android:strokeColor="#6FC9B6"
        android:strokeWidth="3.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M40.95,67.6 A13.05,13.05 0 0 1 67.05,67.6" />
    <path
        android:strokeColor="#3E9E8C"
        android:strokeWidth="3.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M32.98,67.6 A21.02,21.02 0 0 1 75.02,67.6" />
    <path
        android:strokeColor="#2A6F63"
        android:strokeWidth="3.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M25,67.6 A29,29 0 0 1 83,67.6" />

    <!-- 声源(无底版用略深的金,免得在浅壁纸上糊掉) -->
    <path
        android:fillColor="#E0B462"
        android:pathData="M54,67.6 m-3.5,0 a3.5,3.5 0 1 0 7,0 a3.5,3.5 0 1 0 -7,0" />
</vector>
