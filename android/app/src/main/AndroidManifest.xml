<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 局域网同步的组播接收(普通权限,无运行时弹窗):2026-11-13 实测,Wi-Fi 驱动在没有
         MCAST 锁时会过滤组播帧,系统 mdnssd 因此收不到对端的 `_reverb._tcp` 应答,
         Android 永远发现不了鸿蒙。只在同步面板打开期间持锁,关闭即释放。
         同一件事的另一半证据与兜底见 docs/TROUBLESHOOTING.md H276。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17(targetSdk 37)起,"本地网络"是独立权限:组播发现与直连 TCP 都要它。
         本应用唯一的使用者是局域网同步(H276 那套 mDNS + QU 发现 + 47820 直连)。
         ⚠️ 它是**运行时**权限,已在 SettingsScreen 的同步入口按 SDK_INT >= 37 申请;
         不申请不会崩,但会静默发现不到对端(组播被丢、连接超时),比报错更难查。
         36 及以下没有这条权限,声明在旧系统上无副作用。 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- 真实频谱(RECORD_AUDIO + MODIFY_AUDIO_SETTINGS)与应用内更新(REQUEST_INSTALL_PACKAGES)
         原先只声明在 src/default/AndroidManifest.xml,商店那份没有 —— 2026-10-18 两 flavor 合成
         一份包之后,这三条进了唯一的 manifest(理由与代价见 H205):
         · RECORD_AUDIO 只服务于播放页那一个默认关闭的视觉效果,Visualizer(session 0) 读的是
           本机播放输出的混音,平台要求该能力必须持该权限;不采集麦克风、不落盘、不上传。
         · REQUEST_INSTALL_PACKAGES 唯一的消费者是应用内更新(见 update/SelfUpdate.kt),声明它
           不等于授权 —— 真正安装前系统仍会逐次要求放行(见 openInstallPermissionPage)。
         ⚠️ 大陆市场把这两条都列为敏感权限、需逐次举证,提审口径要跟着这份 manifest 走。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 保存图片到相册:Android 10+ 用 MediaStore 免权限,仅 9 及以下需要写外存 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- RECEIVE_BOOT_COMPLETED 不在本应用任何代码里使用,它是 work-runtime 的
         manifest 合入带进来的(RescheduleReceiver)。H75 已把 WorkManager 的
         自动初始化移除、改为隐私同意后惰性初始化,已排程任务在重启后由系统
         JobScheduler 自身的持久化恢复,这个接收器只是锦上添花的兜底。
         而它是灰色软件启发式的高权重项(a.gray 系误报,2026-09 起持续),
         声明着却零消费纯属白付风险 —— 显式从合并结果中移除。 -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <application
        android:name=".ReverbApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Reverb">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Reverb">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 「继续收听」桌面小组件。导出给系统(APPWIDGET_UPDATE 由 launcher 广播),
             组件本身只读本地快照、不初始化网络组件(见 widget/WidgetState 的注释)。 -->
        <receiver
            android:name=".widget.ReverbWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/reverb_widget_info" />
        </receiver>

        <!-- 分享图片(剪藏卡片 / 听觉足迹海报)导出到缓存目录,经 FileProvider 授予临时读权限 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
