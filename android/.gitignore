# 打包产物(build-release.sh 的输出),不入库
/dist
*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/app/build
# 签名密钥与口令不入库
keystore.properties
*.jks
*.keystore
/captures
.externalNativeBuild
.cxx

# 离线语音识别的构建产物与依赖源码:由 tools/build-asr.sh 备好,不入库。
# 理由:一个 57 MB 的模型 + 一个 1.6 MB 的 .so + whisper.cpp 整个仓库,
# 放进 git 会让仓库和每次归档都难看,而它们能由一条命令重建。
# build-release.sh 打包时会检查前两样在不在(见 H205:路径随两 flavor 合并从 src/default 挪到这里)。
/app/src/main/assets/whisper-model.bin
/app/src/main/jniLibs/
/asr-native/whisper.cpp/
/asr-native/build-arm64/
